			reg = <0x1858034 0x04>;
			status = "okay";
			clock-names = "core_clk\0bus_clk\0csi_clk";
			clocks = <0x18 0xaaa3cd97 0x18 0x77fe2384 0x18 0xcc73453c>;
			linux,phandle = <0xa1>;
			phandle = <0xa1>;
		};

		qcom,gdsc@185806c {
			compatible = "qcom,gdsc";
