	chosen {
		bootargs = "sched_enable_hmp=1";
	};

	aliases {
		smd1 = "/soc/qcom,smdtty/qcom,smdtty-apps-fm";
		smd2 = "/soc/qcom,smdtty/smdtty-apps-riva-bt-acl";
		smd3 = "/soc/qcom,smdtty/qcom,smdtty-apps-riva-bt-cmd";
		smd5 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-cmd";
		smd6 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-data";
		smd7 = "/soc/qcom,smdtty/qcom,smdtty-data1";
		smd8 = "/soc/qcom,smdtty/qcom,smdtty-data4";
		smd11 = "/soc/qcom,smdtty/qcom,smdtty-data11";
		smd21 = "/soc/qcom,smdtty/qcom,smdtty-data21";
		smd36 = "/soc/qcom,smdtty/smdtty-loopback";
		sdhc1 = "/soc/sdhci@7824000";
		sdhc2 = "/soc/sdhci@07864000";
		spi0 = "/soc/spi@78ba000";
		spi2 = "/soc/spi@78b6000";
		spi4 = "/soc/spi@78B8000";
		i2c6 = "/soc/i2c@78ba000";
		i2c5 = "/soc/i2c@78b9000";
		i2c3 = "/soc/i2c@78b7000";
		i2c1 = "/soc/i2c@78b5000";
		i2c2 = "/soc/i2c@78b6000";
		i2c4 = "/soc/i2c@78b8000";
		qpic_nand1 = "/soc/nand@7980000";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	firmware {

		android {
			compatible = "android,firmware";

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait";
					status = "ok";
				};

				system {
					compatible = "android,system";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/system";
					type = "ext4";
					mnt_flags = "ro,barrier=1";
					fsmgr_flags = "wait";
					status = "ok";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		external_image__region@0 {
			reg = <0x00 0x87900000 0x00 0x700000>;
			compatible = "removed-dma-pool";
			no-map;
		};

		modem_adsp_region@0 {
			reg = <0x00 0x88000000 0x00 0x5300000>;
			compatible = "removed-dma-pool";
			no-map;
			linux,phandle = <0x0f>;
			phandle = <0x0f>;
		};

		pheripheral_region@0 {
			reg = <0x00 0x8d300000 0x00 0x700000>;
			compatible = "removed-dma-pool";
			no-map;
			linux,phandle = <0x112>;
			phandle = <0x112>;
		};

		venus_qseecom_region@0 {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x00 0x80000000 0x00 0x10000000>;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			linux,phandle = <0x0d>;
			phandle = <0x0d>;
		};

		audio_region@0 {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x400000>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;
		};

		adsp_region@0 {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x400000>;
			linux,phandle = <0x10>;
			phandle = <0x10>;
		};

		splash_region@83000000 {
			reg = <0x00 0x83000000 0x00 0xc00000>;
			linux,phandle = <0x92>;
			phandle = <0x92>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			linux,cma-default;
		};

		secure_region {
			compatible = "shared-dma-pool";
			label = "secure_display_mem";
			size = <0x00 0x1400000>;
			reusable;
			linux,phandle = <0x11>;
			phandle = <0x11>;
		};
	};

