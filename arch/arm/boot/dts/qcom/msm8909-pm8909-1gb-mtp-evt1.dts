			};

			qcom,mode2 {
				qcom,label = "qcom,saw2-spm-cmd-pc";
				qcom,sequence = [20 10 80 30 90 5b 60 03 60 76 76 0b 94 5b 80 10 26 30 0f];
				qcom,spm_en;
				qcom,pc_mode;
				qcom,slp_cmd_mode;
			};
		};

		qcom,spm@b0b9000 {
			compatible = "qcom,spm-v2";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0xb0b9000 0x1000>;
			qcom,name = "cpu3";
			qcom,cpu = <0x05>;
			qcom,core-id = <0x03>;
			qcom,saw2-ver-reg = <0xfd0>;
			qcom,saw2-cfg = <0x01>;
			qcom,saw2-spm-dly = <0x3c102800>;
			qcom,saw2-spm-ctl = <0x0e>;

			qcom,mode0 {
				qcom,label = "qcom,saw2-spm-cmd-wfi";
				qcom,sequence = [60 03 60 0b 0f];
				qcom,spm_en;
			};

			qcom,mode1 {
				qcom,label = "qcom,saw2-spm-cmd-spc";
				qcom,sequence = [20 10 80 30 90 5b 60 03 60 76 76 0b 94 5b 80 10 26 30 0f];
				qcom,spm_en;
				qcom,pc_mode;
			};

			qcom,mode2 {
